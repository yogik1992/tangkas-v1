{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tangkas-v1",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangkas-db",
      "database_id": "4a7a2617-be67-456d-a196-adfdda463323"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "tangkas-private-photos"
    }
  ]
}
